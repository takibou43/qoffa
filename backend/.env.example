# ---- Server ----
NODE_ENV=development
PORT=4000
# روابط الواجهات المسموح لها بالوصول (مفصولة بفاصلة)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# ---- Database ----
# لا تضع بيانات حقيقية هنا
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/qoffa?schema=public
# اختياري: شهادة CA العامة لخادم قاعدة البيانات (PEM) لتفعيل TLS مع تحقق كامل، مثل Supabase Root 2021 CA
DATABASE_CA_CERT=

# ---- Auth ----
# استبدلها بقيمة عشوائية طويلة في الإنتاج: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# ---- Business rules ----
# عمولة المنصة بالنقاط الأساسية (1000 = 10%)
PLATFORM_COMMISSION_BPS=1000
# رسوم التوصيل الافتراضية بالدينار
DEFAULT_DELIVERY_FEE=150
# نصيب الموصل من رسوم التوصيل بالنقاط الأساسية (8000 = 80%)
DRIVER_FEE_SHARE_BPS=8000
# نصف قطر البحث عن المحلات/الموصلين بالكيلومتر
SEARCH_RADIUS_KM=10
# مهلة قبول الموصل للعرض بالثواني
DRIVER_OFFER_TIMEOUT_SECONDS=45
# أقصى عدد موصلين يتم عرض الطلب عليهم قبل NO_DRIVER
MAX_DRIVER_OFFERS=6

# ---- Platform owner (SUPER_ADMIN) ----
# بريد مالك المنصة. عند تشغيل seed يُنشأ الحساب إن لم يكن موجودًا.
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_PHONE=
PLATFORM_OWNER_NAME=
# اختياري: إن تُرك فارغًا يولّد seed كلمة مرور عشوائية ويطبعها مرة واحدة
# ويُجبر المالك على تغييرها عند أول دخول. لا تضع قيمة حقيقية في هذا الملف.
PLATFORM_OWNER_PASSWORD=
