{
  "name": "qoffa",
  "private": true,
  "version": "0.1.0",
  "description": "قُفّة — من حانوتك إلى بابك",
  "workspaces": [
    "backend",
    "frontend-customer",
    "frontend-shop",
    "frontend-driver",
    "frontend-admin"
  ],
  "scripts": {
    "dev:backend": "npm run dev -w backend",
    "dev:customer": "npm run dev -w frontend-customer",
    "dev:shop": "npm run dev -w frontend-shop",
    "dev:driver": "npm run dev -w frontend-driver",
    "dev:admin": "npm run dev -w frontend-admin",
    "build": "npm run build -w backend && npm run build -w frontend-customer && npm run build -w frontend-shop && npm run build -w frontend-driver && npm run build -w frontend-admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "db:studio": "npm run db:studio -w backend",
    "lint:fix": "eslint . --fix"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.70.0"
  }
}
